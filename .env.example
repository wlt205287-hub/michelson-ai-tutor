# Copy to .env at the repository root. Never commit real credentials.
# Model names below are placeholders; choose models available to your account.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=replace-with-your-text-model

ENABLE_VISION=false
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL_NAME=replace-with-your-vision-model

AI_AGENT_LOG_LEVEL=INFO
AI_AGENT_IMAGES_ENABLED=true
AI_AGENT_PUBLIC_BASE_URL=http://127.0.0.1:8000

AI_AGENT_RAG_ENABLED=false
AI_AGENT_RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
AI_AGENT_RAG_CHUNK_SIZE=600
AI_AGENT_RAG_CHUNK_OVERLAP=80
AI_AGENT_RAG_TOP_K=5
AI_AGENT_RAG_MIN_SCORE=0.45
AI_AGENT_RAG_MIN_TEXT_CHARS=4
AI_AGENT_RAG_COLLECTION=ai_agent_rag

# Optional path overrides. Omit to use paths relative to the source files.
# AI_AGENT_RAG_DOCS_DIR=
# AI_AGENT_RAG_INDEX_DIR=
